# Atlas-Plugin 配置文件
# 优先级：数字越小越先执行（建议不低于10000，避免干扰 miao-plugin 等）
priority: 10000

# 渲染缩放比例
renderScale: 1.5

# ---------- 通知 ----------
# 更新完成后通知的群号列表（逗号分隔），留空仅通知主人
notifyGroups: []
# 通知模式：all=全部主人+配置群 / master_only=全部主人 / first_master=第一位主人 / first_master_groups=第一位主人+群聊
notifyMode: 'all'

# ---------- 自动更新 ----------
autoUpdate:
  # 是否启用每日自动抓取更新
  enabled: true
  # 自动更新 cron 表达式（6字段：秒 分 时 日 月 周）
  cron: '0 0 5 * * *'
  # 增量抓取失败后的重试次数
  retries: 1
  # 重试前的等待毫秒数
  retryDelayMs: 30000
  # 增量抓取多次失败后是否降级全量抓取
  fallbackToFull: true
  # 单次抓取超时毫秒数（默认 7200000 = 2 小时）
  timeoutMs: 7200000

# ---------- 别名管理 ----------
# #图鉴别名设置/删除 的权限（master=仅主人 / group_admin=群主或管理员 / all=所有人）
alias:
  set: master
  del: master
  # 列表查看默认为 all（只读，不涉敏感）
  list: all
